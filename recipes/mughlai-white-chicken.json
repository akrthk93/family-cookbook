  "steps": [
    {
      "t": "Marinate the chicken",
      "x": "Mix chicken with yogurt, ginger, garlic, white pepper and salt. Refrigerate at least 30 min.",
      "min": 30
    },
    {
      "t": "Make cashew paste",
      "x": "Soak cashews in warm water 15 min. Drain, grind smooth with 2–3 tbsp water.",
      "min": 15
    },
    {
      "t": "Aromatics and onions",
      "x": "Ghee, medium heat. Whole spices 30 sec. Add onions, 8–10 min until soft and pale golden, not brown. Remove onions and spices, set aside.",
      "min": 9
    },
    {
      "t": "Sear chicken",
      "x": "Same pan, medium heat. Add chicken, 6–8 min until yogurt coats it and it's half cooked.",
      "min": 7
    },
    {
      "t": "Build the masala",
      "x": "Return onions. Add ginger-garlic and chillies, 1 min. Stir in cashew paste, low heat 2–3 min until oil starts to separate.",
      "min": 3
    },
    {
      "t": "Finish with cream",
      "x": "Add cream, low heat, simmer 12–15 min until chicken is cooked. Season with salt, sugar and garam masala, 2–3 more min. Never raise the heat after cream goes in.",
      "min": 13
    }
  ],
  "notes": [
    "Keep onions pale to keep the gravy white.",
    "Serve with naan, roti or basmati rice."
  ]
}
