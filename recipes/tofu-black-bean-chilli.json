  "steps": [
    {
      "t": "Brown the tofu",
      "x": "Crumble the pressed tofu by hand into mince-sized pieces. Heat the oil in the wok on medium-high, add the tofu and leave it 3 min before stirring. Cook 8–10 min in total until golden and dry at the edges, then add the soy sauce, toss 30 sec and tip onto a plate. Browning first is what gives it a mince-like chew. (Paneer: pan-fry the cubes 4 min until golden and set aside.)",
      "uses": [
        "0.0",
        "0.1",
        "0.2"
      ],
      "on": "wok",
      "act": 11,
      "wait": 0
    },
    {
      "t": "Soften the veg",
      "x": "Add the oil to the wok, then the onion and capsicum, and cook 5 min until soft.",
      "uses": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "on": "wok",
      "act": 5,
      "wait": 0
    },
    {
      "t": "Spices and paste",
      "x": "Add garlic, cumin, paprika, oregano, chilli powder and tomato paste and stir 2 min until the paste darkens.",
      "uses": [
        "1.3",
        "1.4",
