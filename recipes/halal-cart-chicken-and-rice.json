    {
      "t": "Rinse the rice",
      "x": "Rinse the basmati until the water runs clear. Drain well for 5 min.",
      "uses": [
        "1.0",
        "1.4"
      ]
    },
    {
      "t": "Sear the chicken in the pot",
      "x": "Wipe off the thick excess marinade from the thighs and leave a thin coat. Set the Instant Pot to Sauté (More/High). Add 2 tbsp oil and heat 2 min. Sear the thighs smooth side down in 2 batches, 3 min per side, until golden. Move to a plate.",
      "uses": [
        "0.11"
      ]
    },
    {
      "t": "Clean the pot base",
      "x": "Press Cancel. Scrape any burnt or blackened bits off the bottom with a wooden spoon and discard them. Keep the browned fond.",
      "uses": []
    },
    {
      "t": "Toast the rice",
      "x": "Set to Sauté (Normal). Add 3 tbsp oil, heat 1 min, then add the rice and toast 4 min, stirring constantly.",
      "uses": [
        "1.1"
      ]
    },
    {
      "t": "Butter, turmeric and liquid",
      "x": "Stir in the butter and turmeric for 1 min. Add the water, crumbled Knorr cubes, 5 g onion powder and 5 g garlic powder. Stir and scrape the bottom completely clean, otherwise you get a Burn notice. Level the rice and press Cancel.",
      "uses": [
        "0.6",
        "0.7",
        "1.3"
      ]
    },
    {
      "t": "Chicken on top",
      "x": "Lay the seared thighs on top of the rice in a single layer. Do not stir. Add the plate juices.",
      "uses": []
    },
